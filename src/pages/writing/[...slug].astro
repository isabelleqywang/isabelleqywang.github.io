---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getPosts, readingMinutes, formatDate, isoDate, tagLabel, type Post } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const url = new URL(`/writing/${post.id}/`, Astro.site).href;

const article = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  author: { "@type": "Person", name: "Isabelle Wang", url: "https://isabelleqywang.github.io/" },
  keywords: post.data.tags.join(", "),
  mainEntityOfPage: url,
};
---

<Base title={post.data.title} description={post.data.summary} current="Writing" type="article" published={post.data.date} jsonLd={article}>
  <article class="post">
    <header>
      <p class="label"><a href="/writing/">Writing</a></p>
      <h1>{post.data.title}</h1>
      <p class="meta">
        <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time> · {readingMinutes(post)} min read
        {post.data.tags.length > 0 && <> · {post.data.tags.map((t, i) => <>{i > 0 && ", "}<a href={`/writing/tags/${t}/`}>{tagLabel(t)}</a></>)}</>}
      </p>
    </header>
    <div class="prose"><Content /></div>
    <nav class="pager" aria-label="More writing">
      {older ? <a href={`/writing/${older.id}/`} rel="prev"><span class="meta">Older</span><span>{older.data.title}</span></a> : <span></span>}
      {newer && <a class="next" href={`/writing/${newer.id}/`} rel="next"><span class="meta">Newer</span><span>{newer.data.title}</span></a>}
    </nav>
  </article>
</Base>

<style>
  .post { max-width: 720px; margin: 0 auto; padding: clamp(140px, 20vh, 200px) 24px clamp(96px, 14vh, 140px); }
  header h1 { font: 300 clamp(38px, 5vw, 60px)/1.08 var(--serif); color: var(--silver); margin: 18px 0 18px; }
  header .meta a:hover { color: var(--blue); }
  header { padding-bottom: 36px; border-bottom: 1px solid var(--faint); margin-bottom: 40px; }

  /* reading first: comfortable measure, generous leading, quiet colour */
  .prose { font-size: 18px; line-height: 1.8; color: #d3d7df; }
  .prose :global(> * + *) { margin-top: 1.1em; }
  .prose :global(h2) { font: 300 30px/1.2 var(--serif); color: var(--silver); margin-top: 2em; }
  .prose :global(h3) { font: 500 18px/1.4 var(--sans); color: var(--silver); margin-top: 1.8em; }
  .prose :global(a) { color: var(--silver); border-bottom: 1px solid rgba(140, 180, 255, 0.45); }
  .prose :global(a:hover) { color: var(--blue); }
  .prose :global(strong) { color: var(--silver); font-weight: 500; }
  .prose :global(em) { color: var(--text); }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.3em; }
  .prose :global(li + li) { margin-top: 0.4em; }
  .prose :global(blockquote) { border-left: 1px solid var(--blue); padding-left: 1.2em; color: var(--text); font-family: var(--serif); font-size: 21px; }
  .prose :global(:not(pre) > code) { font: 0.86em var(--mono); background: rgba(140, 180, 255, 0.08); padding: 0.12em 0.4em; border-radius: 3px; color: var(--silver); }
  .prose :global(pre) {
    font: 14px/1.65 var(--mono); padding: 20px 22px; border-radius: 6px; overflow-x: auto;
    background: #070b18 !important; border: 1px solid var(--faint); margin: 1.6em 0;
  }
  .prose :global(img) { display: block; margin: 2em auto; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--faint); margin: 2.4em 0; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 72px; padding-top: 28px; border-top: 1px solid var(--faint); }
  .pager a { display: grid; gap: 6px; font: 300 20px/1.3 var(--serif); color: var(--silver); }
  .pager a:hover span:last-child { color: var(--blue); }
  .pager .next { text-align: right; }
  @media (max-width: 760px) {
    .post { padding: 110px 20px 80px; }
    .prose { font-size: 17px; }
    .pager { grid-template-columns: 1fr; }
    .pager .next { text-align: left; }
  }
</style>
